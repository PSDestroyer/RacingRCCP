--- !u!114 &7612889541566066761
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5706437749792705760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ccfbcc1504c500141a95e725b3c758e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - timestamp: 2026-04-29 16:29:03
    panelType: Vehicle Customization
    userPrompt: Create JDM turbo AWD
    explanation: 'JDM turbo AWD configuration applied: +20 Nm torque (520 Nm) for
      aggressive power delivery, increased turbo PSI (20) and coefficient (1.7) for
      snappy boost response, quickened engine inertia (0.08) for snappier throttle.
      Upgraded suspension stiffness (spring +13%, damper +13%) and lowered distance
      (0.15m) for aggressive stance and responsive handling. Enhanced grip with improved
      friction (forward/sideways extremum 1.05, stiffness 1.1) and added moderate
      downforce (45) for stability. Increased differential slip ratio (75) for better
      power distribution. Faster shifts (0.12s) and higher shift RPM (6800) for spirited
      driving. Stiffer antiroll bars (front +200, rear +250) for planted corners.
      Counter-steering enabled for drift-capable JDM feel. Vehicle maintains AWD
      grip with Limited slip differentials for controlled aggression.'
    appliedJson: "{\n  \"vehicleConfig\": {\n    \"mass\": 1450\n  },\n  \"driveType\":
      \"AWD\",\n  \"engine\": {\n    \"maximumTorqueAsNM\": 520,\n    \"minEngineRPM\":
      800,\n    \"maxEngineRPM\": 8500,\n    \"maximumSpeed\": 260,\n    \"engineInertia\":
      0.08,\n    \"turboCharged\": true,\n    \"maxTurboChargePsi\": 20,\n    \"turboChargerCoEfficient\":
      1.7\n  },\n  \"clutch\": {\n    \"clutchInertia\": 0.05,\n    \"engageRPM\":
      1800,\n    \"automaticClutch\": true\n  },\n  \"gearbox\": {\n    \"transmissionType\":
      \"Automatic\",\n    \"gearRatios\": [3.8, 2.4, 1.7, 1.25, 1.0, 0.82],\n   
      \"shiftingTime\": 0.12,\n    \"shiftUpRPM\": 6800,\n    \"shiftDownRPM\": 3200\n 
      },\n  \"differential\": {\n    \"type\": \"Limited\",\n    \"limitedSlipRatio\":
      75,\n    \"finalDriveRatio\": 4.2\n  },\n  \"axles\": {\n    \"front\": {\n     
      \"maxSteerAngle\": 38,\n      \"maxBrakeTorque\": 4200,\n      \"antirollForce\":
      850\n    },\n    \"rear\": {\n      \"maxBrakeTorque\": 4000,\n      \"antirollForce\":
      950\n    }\n  },\n  \"suspension\": {\n    \"distance\": 0.15,\n    \"spring\":
      58700,\n    \"damper\": 5283\n  },\n  \"wheelFriction\": {\n    \"forward\":
      {\n      \"extremumSlip\": 0.4,\n      \"extremumValue\": 1.05,\n      \"asymptoteSlip\":
      0.8,\n      \"asymptoteValue\": 0.55,\n      \"stiffness\": 1.1\n    },\n   
      \"sideways\": {\n      \"extremumSlip\": 0.35,\n      \"extremumValue\": 1.05,\n     
      \"asymptoteSlip\": 0.5,\n      \"asymptoteValue\": 0.8,\n      \"stiffness\":
      1.1\n    }\n  },\n  \"aerodynamics\": {\n    \"downForce\": 45,\n    \"airResistance\":
      12,\n    \"wheelResistance\": 12\n  },\n  \"stability\": {\n    \"ABS\": true,\n   
      \"ESP\": true,\n    \"TCS\": true,\n    \"steeringHelper\": true,\n    \"tractionHelper\":
      true,\n    \"angularDragHelper\": false,\n    \"steerHelperStrength\": 0.3,\n   
      \"tractionHelperStrength\": 0.35\n  },\n  \"input\": {\n    \"counterSteering\":
      true,\n    \"counterSteerFactor\": 0.6\n  },\n  \"explanation\": \"JDM turbo
      AWD configuration applied: +20 Nm torque (520 Nm) for aggressive power delivery,
      increased turbo PSI (20) and coefficient (1.7) for snappy boost response, quickened
      engine inertia (0.08) for snappier throttle. Upgraded suspension stiffness
      (spring +13%, damper +13%) and lowered distance (0.15m) for aggressive stance
      and responsive handling. Enhanced grip with improved friction (forward/sideways
      extremum 1.05, stiffness 1.1) and added moderate downforce (45) for stability.
      Increased differential slip ratio (75) for better power distribution. Faster
      shifts (0.12s) and higher shift RPM (6800) for spirited driving. Stiffer antiroll
      bars (front +200, rear +250) for planted corners. Counter-steering enabled
      for drift-capable JDM feel. Vehicle maintains AWD grip with Limited slip differentials
      for controlled aggression.\"\n}"
    beforeState: "Mass: 1450kg\nEngine: 500Nm, 800-7500RPM, 240km/h\n  Turbo: 18psi\nClutch:
      engageRPM=2000, inertia=0.06, auto=True\nGearbox: Automatic, 6 gears, shift=0.15s\n 
      Ratios: [3.8, 2.4, 1.7, 1.25, 1, 0.82]\n  ShiftRPM: up=7000, down=3500\nDiff
      (RCCP_Axle_Front): Limited, slip=65, final=4.1\nDiff (RCCP_Axle_Rear): Limited,
      slip=65, final=4.1\nAxle (RCCP_Axle_Front): steer=True, power=False, brake=True\n 
      steerAngle=38, brakeTorque=3800, antiroll=650\nAxle (RCCP_Axle_Rear): steer=False,
      power=False, brake=True\n  steerAngle=40, brakeTorque=3500, antiroll=700\nStability:
      ABS=True, ESP=True, TCS=True\n  steerHelper=True (0.35), tractionHelper=True
      (0.38)\nSuspension: dist=0.16m, spring=52000, damper=4680\nWheels (Front):
