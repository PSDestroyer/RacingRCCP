      0.05,\n    \"engageRPM\": 2000\n  },\n  \"gearbox\": {\n    \"transmissionType\":
      \"Automatic\",\n    \"shiftingTime\": 0.1,\n    \"shiftThreshold\": 0.85,\n   
      \"shiftUpRPM\": 8500,\n    \"shiftDownRPM\": 4000\n  },\n  \"differential\":
      {\n    \"type\": \"Limited\",\n    \"limitedSlipRatio\": 75,\n    \"finalDriveRatio\":
      4.1\n  },\n  \"axles\": {\n    \"front\": {\n      \"maxSteerAngle\": 38,\n     
