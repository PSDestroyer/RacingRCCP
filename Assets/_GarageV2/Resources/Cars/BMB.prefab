      \"angularDragHelper\": true,\n    \"angularDragHelperStrength\": 0.3\n  },\n 
      \"axles\": {\n    \"front\": {\n      \"antirollForce\": 2000\n    },\n   
      \"rear\": {\n      \"antirollForce\": 2200\n    }\n  },\n  \"aerodynamics\":
      {\n    \"downForce\": 80\n  },\n  \"vehicleConfig\": {\n    \"centerOfMassOffset\":
      {\n      \"y\": -0.15\n    }\n  },\n  \"wheelFriction\": {\n    \"sideways\":
      {\n      \"extremumSlip\": 0.35,\n      \"extremumValue\": 1.1,\n      \"asymptoteSlip\":
      0.5,\n      \"asymptoteValue\": 0.85,\n      \"stiffness\": 1.2\n    }\n  },\n 
      \"explanation\": \"Increased stability by: enabling angularDragHelper (0.3)
      to prevent spinning, boosting helper strengths (steerHelper 0.35, tractionHelper
      0.5), doubling antiroll forces for less body roll, adding downForce (80) for
      speed-dependent grip, lowering COM (-0.15m) for better balance, and stiffening
      sideways friction (extremum 1.1, asymptote 0.85, stiffness 1.2) for better
      cornering control. Vehicle will feel planted and confident.\"\n}"
