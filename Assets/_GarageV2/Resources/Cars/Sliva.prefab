MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4294604000970585936}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ccfbcc1504c500141a95e725b3c758e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - timestamp: 2026-04-29 15:35:49
    panelType: Vehicle Creation
    userPrompt: 'Create JDM style supercar RWD '
    explanation: JDM-inspired RWD supercar with aggressive turbo setup (18 psi, 650Nm),
      high-revving 9500 RPM engine, and Limited slip differential (70%) for mid-corner
      stability. Sport-tuned suspension (0.14m, 52k spring) provides responsive handling.
      Realistic friction curve with 1.2x grip multiplier. NOS enabled for authentic
      tuner car feel. Compact 1300kg chassis with 320km/h top speed capability. Modern
      stability aids with modest helper strengths (0.2-0.3) for engaging but controllable
      dynamics.
    appliedJson: "{\n  \"vehicleConfig\": {\n    \"name\": \"JDM Supercar\",\n   
      \"mass\": 1300\n  },\n  \"driveType\": \"RWD\",\n  \"engine\": {\n    \"maximumTorqueAsNM\":
      650,\n    \"minEngineRPM\": 800,\n    \"maxEngineRPM\": 9500,\n    \"maximumSpeed\":
      320,\n    \"engineInertia\": 0.06,\n    \"engineFriction\": 0.15,\n    \"turboCharged\":
      true,\n    \"maxTurboChargePsi\": 18,\n    \"turboChargerCoEfficient\": 1.6\n 
      },\n  \"clutch\": {\n    \"clutchInertia\": 0.06,\n    \"engageRPM\": 2000,\n   
      \"automaticClutch\": true,\n    \"pressClutchWhileShiftingGears\": true,\n   
      \"pressClutchWhileHandbraking\": true\n  },\n  \"gearbox\": {\n    \"transmissionType\":
      \"Automatic\",\n    \"gearRatios\": [3.8, 2.4, 1.7, 1.25, 1.0, 0.82],\n   
      \"shiftingTime\": 0.15,\n    \"shiftThreshold\": 0.85,\n    \"shiftUpRPM\":
      9000,\n    \"shiftDownRPM\": 4500\n  },\n  \"differential\": {\n    \"type\":
      \"Limited\",\n    \"limitedSlipRatio\": 70,\n    \"finalDriveRatio\": 3.9\n 
      },\n  \"axles\": {\n    \"front\": {\n      \"isSteer\": true,\n      \"isBrake\":
      true,\n      \"isHandbrake\": false,\n      \"maxSteerAngle\": 36,\n      \"maxBrakeTorque\":
      4200,\n      \"antirollForce\": 650,\n      \"steerSpeed\": 4.5,\n      \"powerMultiplier\":
      1.0,\n      \"brakeMultiplier\": 1.0\n    },\n    \"rear\": {\n      \"isSteer\":
      false,\n      \"isBrake\": true,\n      \"isHandbrake\": true,\n      \"maxBrakeTorque\":
      3800,\n      \"antirollForce\": 750,\n      \"powerMultiplier\": 1.0,\n     
      \"brakeMultiplier\": 1.0,\n      \"handbrakeMultiplier\": 0.9\n    }\n  },\n 
      \"suspension\": {\n    \"distance\": 0.14,\n    \"spring\": 52000,\n    \"damper\":
      4680\n  },\n  \"wheelFriction\": {\n    \"type\": \"Realistic\"\n  },\n  \"wheels\":
      {\n    \"wheelWidth\": 0.28,\n    \"grip\": 1.2,\n    \"camber\": -2.0,\n   
      \"caster\": 6\n  },\n  \"stability\": {\n    \"ABS\": true,\n    \"ESP\": true,\n   
      \"TCS\": true,\n    \"steeringHelper\": true,\n    \"tractionHelper\": true,\n   
      \"angularDragHelper\": true,\n    \"steerHelperStrength\": 0.25,\n    \"tractionHelperStrength\":
      0.3,\n    \"angularDragHelperStrength\": 0.2\n  },\n  \"aeroDynamics\": {\n   
      \"downForce\": 120,\n    \"airResistance\": 12,\n    \"wheelResistance\": 8\n 
      },\n  \"nos\": {\n    \"enabled\": true,\n    \"torqueMultiplier\": 2.2,\n   
      \"durationTime\": 4,\n    \"regenerateTime\": 3,\n    \"regenerateRate\": 1.5\n 
      },\n  \"fuelTank\": {\n    \"enabled\": false\n  },\n  \"limiter\": {\n   
      \"enabled\": false\n  },\n  \"input\": {\n    \"counterSteering\": true,\n   
      \"counterSteerFactor\": 0.6,\n    \"steeringLimiter\": true,\n    \"autoReverse\":
      true,\n    \"steeringDeadzone\": 0.05\n  },\n  \"explanation\": \"JDM-inspired
      RWD supercar with aggressive turbo setup (18 psi, 650Nm), high-revving 9500
      RPM engine, and Limited slip differential (70%) for mid-corner stability. Sport-tuned
      suspension (0.14m, 52k spring) provides responsive handling. Realistic friction
      curve with 1.2x grip multiplier. NOS enabled for authentic tuner car feel.
      Compact 1300kg chassis with 320km/h top speed capability. Modern stability
      aids with modest helper strengths (0.2-0.3) for engaging but controllable dynamics.\"\n}"
    beforeState: (New vehicle)
    beforeStateJson: 
    afterState: "Mass: 1300kg\nEngine: 650Nm, 800-9500RPM, 240km/h\n  Turbo: 18psi\nClutch:
      engageRPM=2000, inertia=0.06, auto=True\nGearbox: Automatic, 6 gears, shift=0.15s\n 
      Ratios: [3.8, 2.4, 1.7, 1.25, 1, 0.82]\n  ShiftRPM: up=9000, down=4500\nDiff
      (RCCP_Axle_Rear): Limited, slip=70, final=3.9\nAxle (RCCP_Axle_Front): steer=True,
      power=False, brake=True\n  steerAngle=36, brakeTorque=4200, antiroll=650\nAxle
      (RCCP_Axle_Rear): steer=False, power=False, brake=True\n  steerAngle=40, brakeTorque=3800,
      antiroll=750\nStability: ABS=True, ESP=True, TCS=True\n  steerHelper=True (0.25),
      tractionHelper=True (0.3)\nSuspension: dist=0.14m, spring=52000, damper=4680\nWheels
      (Front): camber=0.0\xB0, caster=0.0\xB0, grip=1.00, width=0.250m\nWheels (Rear):
      camber=0.0\xB0, caster=0.0\xB0, grip=1.00, width=0.250m\nAero: downForce=10\nInput:
      counterSteerFactor=0.5, counterSteering=True, steeringLimiter=True\nAudio Layer
      0: RPM=0-4000, pitch=0.85-1.45, vol=0.60, dist=10-120\nAudio Layer 1: RPM=2000-7000,
      pitch=0.85-1.75, vol=0.65, dist=10-120\nAudio Layer 2: RPM=5000-8000, pitch=0.90-1.30,
      vol=0.70, dist=10-120\nAudio Layer 3: RPM=0-1200, pitch=0.55-1.55, vol=0.60,
      dist=10-120\n"
  maxEntries: 50
