--- !u!114 &581929561089927847
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6942894796715127710}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ccfbcc1504c500141a95e725b3c758e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - timestamp: 2026-04-29 17:39:43
    panelType: Vehicle Creation
    userPrompt: Create Forza style Hypercar
    explanation: Lamborghini Revuelto configured as a Forza-style hypercar. AWD with
      900Nm turbo V12 hybrid powerhouse, 7-speed automatic, lightweight 1300kg carbon
      fiber construction, aggressive aerodynamics (220 downforce), track-tuned suspension
      (0.13m distance), and premium Forza-balanced stability with moderate assists
      for accessible performance driving. Limited-slip differential ensures precise
      power delivery. Forgiving but responsive handling appropriate for arcade-simulation
      hybrid gameplay.
    appliedJson: "{\n  \"vehicleConfig\": {\n    \"name\": \"Lamborghini Revuelto
      Hypercar\",\n    \"mass\": 1300\n  },\n  \"driveType\": \"AWD\",\n  \"engine\":
      {\n    \"maximumTorqueAsNM\": 900,\n    \"minEngineRPM\": 1000,\n    \"maxEngineRPM\":
      9500,\n    \"maximumSpeed\": 350,\n    \"engineInertia\": 0.06,\n    \"engineFriction\":
      0.15,\n    \"turboCharged\": true,\n    \"maxTurboChargePsi\": 18,\n    \"turboChargerCoEfficient\":
      1.6\n  },\n  \"clutch\": {\n    \"clutchInertia\": 0.06,\n    \"engageRPM\":
      2500,\n    \"automaticClutch\": true,\n    \"pressClutchWhileShiftingGears\":
      true,\n    \"pressClutchWhileHandbraking\": true\n  },\n  \"gearbox\": {\n   
      \"transmissionType\": \"Automatic\",\n    \"gearRatios\": [3.8, 2.4, 1.72,
      1.28, 1.0, 0.82, 0.68],\n    \"shiftingTime\": 0.12,\n    \"shiftThreshold\":
      0.88,\n    \"shiftUpRPM\": 9200,\n    \"shiftDownRPM\": 4000\n  },\n  \"differential\":
      {\n    \"type\": \"Limited\",\n    \"limitedSlipRatio\": 70,\n    \"finalDriveRatio\":
      3.2\n  },\n  \"axles\": {\n    \"front\": {\n      \"isSteer\": true,\n     
      \"isBrake\": true,\n      \"isHandbrake\": false,\n      \"maxSteerAngle\":
      32,\n      \"maxBrakeTorque\": 5500,\n      \"antirollForce\": 900,\n     
      \"steerSpeed\": 3.5,\n      \"powerMultiplier\": 0.5,\n      \"brakeMultiplier\":
      1.0\n    },\n    \"rear\": {\n      \"isSteer\": false,\n      \"isBrake\":
      true,\n      \"isHandbrake\": true,\n      \"maxBrakeTorque\": 5000,\n     
      \"antirollForce\": 950,\n      \"powerMultiplier\": 0.5,\n      \"brakeMultiplier\":
      1.0,\n      \"handbrakeMultiplier\": 0.9\n    }\n  },\n  \"suspension\": {\n   
      \"distance\": 0.13,\n    \"spring\": 52000,\n    \"damper\": 4680\n  },\n 
      \"wheelFriction\": {\n    \"type\": \"Balanced\"\n  },\n  \"wheels\": {\n   
      \"wheelWidth\": 0.32,\n    \"camber\": -2.0,\n    \"caster\": 6\n  },\n  \"stability\":
      {\n    \"ABS\": true,\n    \"ESP\": true,\n    \"TCS\": true,\n    \"steeringHelper\":
      true,\n    \"tractionHelper\": true,\n    \"angularDragHelper\": true,\n   
      \"steerHelperStrength\": 0.35,\n    \"tractionHelperStrength\": 0.30,\n   
      \"angularDragHelperStrength\": 0.25\n  },\n  \"aeroDynamics\": {\n    \"downForce\":
      220,\n    \"airResistance\": 12,\n    \"wheelResistance\": 11\n  },\n  \"nos\":
      {\n    \"enabled\": false\n  },\n  \"fuelTank\": {\n    \"enabled\": false\n 
      },\n  \"limiter\": {\n    \"enabled\": false\n  },\n  \"input\": {\n    \"counterSteering\":
      true,\n    \"counterSteerFactor\": 0.45,\n    \"steeringLimiter\": true,\n   
      \"autoReverse\": true,\n    \"steeringDeadzone\": 0.03\n  },\n  \"explanation\":
      \"Lamborghini Revuelto configured as a Forza-style hypercar. AWD with 900Nm
      turbo V12 hybrid powerhouse, 7-speed automatic, lightweight 1300kg carbon fiber
      construction, aggressive aerodynamics (220 downforce), track-tuned suspension
      (0.13m distance), and premium Forza-balanced stability with moderate assists
      for accessible performance driving. Limited-slip differential ensures precise
      power delivery. Forgiving but responsive handling appropriate for arcade-simulation
      hybrid gameplay.\"\n}"
    beforeState: (New vehicle)
    beforeStateJson: 
    afterState: "Mass: 1300kg\nEngine: 900Nm, 1000-9500RPM, 240km/h\n  Turbo: 18psi\nClutch:
      engageRPM=2500, inertia=0.06, auto=True\nGearbox: Automatic, 7 gears, shift=0.12s\n 
      Ratios: [3.8, 2.4, 1.72, 1.28, 1, 0.82, 0.68]\n  ShiftRPM: up=9200, down=4000\nDiff
      (RCCP_Axle_Front): Limited, slip=70, final=3.2\nDiff (RCCP_Axle_Rear): Limited,
      slip=70, final=3.2\nAxle (RCCP_Axle_Front): steer=True, power=False, brake=True\n 
      steerAngle=32, brakeTorque=5500, antiroll=900\nAxle (RCCP_Axle_Rear): steer=False,
      power=False, brake=True\n  steerAngle=40, brakeTorque=5000, antiroll=950\nStability:
      ABS=True, ESP=True, TCS=True\n  steerHelper=True (0.35), tractionHelper=True
      (0.3)\nSuspension: dist=0.13m, spring=52000, damper=4680\nWheels (Front): camber=0.0\xB0,
      caster=0.0\xB0, grip=1.00, width=0.250m\nWheels (Rear): camber=0.0\xB0, caster=0.0\xB0,
      grip=1.00, width=0.250m\nAero: downForce=10\nInput: counterSteerFactor=0.5,
      counterSteering=True, steeringLimiter=True\nAudio Layer 0: RPM=0-4000, pitch=0.85-1.45,
      vol=0.60, dist=10-120\nAudio Layer 1: RPM=2000-7000, pitch=0.85-1.75, vol=0.65,
      dist=10-120\nAudio Layer 2: RPM=5000-8000, pitch=0.90-1.30, vol=0.70, dist=10-120\nAudio
      Layer 3: RPM=0-1200, pitch=0.55-1.55, vol=0.60, dist=10-120\n"
  maxEntries: 50
