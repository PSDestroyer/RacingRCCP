    m_Metadata:
      m_Items: []
  - m_Id: 8572100668
    m_Localized: "Agrandissez le texte jusqu'\xE0 115%."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100669
    m_Localized: "Affichez les \xE9crans et les s\xE9lections sans animation."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100670
    m_Localized: "Assombrissez l'arri\xE8re-plan pour mieux lire les menus."
    m_Metadata:
      m_Items: []
