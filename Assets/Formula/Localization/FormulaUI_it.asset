  - m_Id: 8572100659
    m_Localized: "\u2039 Indietro"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100660
    m_Localized: "Avanti \u203A"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100661
    m_Localized: Ripristina i comandi del dispositivo
    m_Metadata:
      m_Items: []
  - m_Id: 8572100663
    m_Localized: Passa tra schermo intero e finestra.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100664
    m_Localized: Allontana i comandi dai bordi dello schermo.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100665
    m_Localized: "Limita i fotogrammi al secondo. Il V-sync pu\xF2 modificare il
      limite."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100666
    m_Localized: Scorri le impostazioni grafiche disponibili.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100667
    m_Localized: Sincronizza i fotogrammi con lo schermo.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100668
    m_Localized: Ingrandisci il testo fino al 115%.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100669
    m_Localized: Cambia schermata e selezione senza animazioni.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100670
    m_Localized: Scurisci lo sfondo per leggere meglio i menu.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100671
    m_Localized: DIFFERENZE DALLA SERIE
    m_Metadata:
      m_Items: []
  - m_Id: 8572100672
    m_Localized: "Solo estetica \xB7 Potenziamenti e assetto invariati."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100673
    m_Localized: "Scegli un livello acquistato. Cambiare \xE8 gratis."
    m_Metadata:
