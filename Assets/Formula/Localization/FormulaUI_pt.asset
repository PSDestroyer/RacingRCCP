    m_Localized: "AJUDAS \xC0 CONDU\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100641
    m_Localized: "Ajudas gratuitas \xB7 Mesmas recompensas"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100642
    m_Localized: Evita o bloqueio das rodas ao travar
    m_Metadata:
      m_Items: []
  - m_Id: 8572100643
    m_Localized: Limita a patinagem das rodas ao acelerar
    m_Metadata:
      m_Items: []
