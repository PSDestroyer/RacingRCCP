    m_Localized: "Menos apoio: mais velocidade em reta.\nMais apoio: mais ader\xEAncia
      em curvas r\xE1pidas."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100632
    m_Localized: "Testa o equil\xEDbrio. Todas as afina\xE7\xF5es s\xE3o gratuitas."
