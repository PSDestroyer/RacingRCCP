    m_Metadata:
      m_Items: []
  - m_Id: 8572100661
    m_Localized: Repor os controlos do dispositivo
    m_Metadata:
      m_Items: []
  - m_Id: 8572100663
    m_Localized: "Alterna entre ecr\xE3 inteiro e janela."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100664
    m_Localized: "Afasta os controlos das margens do ecr\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100665
    m_Localized: Limita as imagens por segundo. O V-sync pode alterar este limite.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100666
    m_Localized: "Alterna entre as predefini\xE7\xF5es gr\xE1ficas dispon\xEDveis."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100667
    m_Localized: "Sincroniza as imagens com o ecr\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100668
    m_Localized: "Aumenta o tamanho do texto at\xE9 115%."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100669
    m_Localized: "Muda de ecr\xE3 e sele\xE7\xE3o sem anima\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100670
    m_Localized: Escurece o fundo para facilitar a leitura dos menus.
    m_Metadata:
      m_Items: []
