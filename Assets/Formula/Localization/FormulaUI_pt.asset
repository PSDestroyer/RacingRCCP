  - m_Id: 8534351872
    m_Localized: MENU PRINCIPAL
    m_Metadata:
      m_Items: []
  - m_Id: 8534351873
    m_Localized: "Bin\xE1rio +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351874
    m_Localized: Sem desvantagens adicionais
    m_Metadata:
      m_Items: []
  - m_Id: 8534351875
    m_Localized: "Mais bin\xE1rio melhora a acelera\xE7\xE3o se houver ader\xEAncia
      suficiente."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351876
    m_Localized: "Bin\xE1rio de travagem +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351877
    m_Localized: "Distribui\xE7\xE3o de travagem dianteira-traseira mantida"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351878
    m_Localized: "Mais bin\xE1rio de travagem aumenta a for\xE7a de travagem. A ader\xEAncia
      e o ABS limitam a dist\xE2ncia de paragem."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351879
    m_Localized: "Molas +{0:0.#}% \u2192 +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351880
    m_Localized: "Amortecimento +{0:0.#}% \xB7 Barra estabilizadora +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351881
    m_Localized: "Chassis mais firme, mas menos flex\xEDvel nas irregularidades."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351882
    m_Localized: "APOIO AERODIN\xC2MICO +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351883
    m_Localized: "Resist\xEAncia +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351884
    m_Localized: "Mais ader\xEAncia em curvas r\xE1pidas, mas mais resist\xEAncia
      ao ar."
    m_Metadata:
      m_Items: []
