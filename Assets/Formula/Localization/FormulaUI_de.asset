  - m_Id: 8572100659
    m_Localized: "\u2039 Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100660
    m_Localized: "Weiter \u203A"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100661
    m_Localized: "Ger\xE4tebelegung zur\xFCcksetzen"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100663
    m_Localized: Wechsle zwischen Vollbild und Fenster.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100664
    m_Localized: Halte die Bedienelemente vom Bildschirmrand fern.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100665
    m_Localized: "Begrenze die Bildrate. V-Sync kann diese Grenze \xE4ndern."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100666
    m_Localized: "Wechsle zwischen den verf\xFCgbaren Grafikprofilen."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100667
    m_Localized: Synchronisiere die Bildausgabe mit deinem Bildschirm.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100668
    m_Localized: "Vergr\xF6\xDFere den Text auf bis zu 115%."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100669
    m_Localized: Wechsle Bildschirme und Auswahl ohne Animationen.
    m_Metadata:
      m_Items: []
  - m_Id: 8572100670
    m_Localized: "Dunkle den Hintergrund f\xFCr besser lesbare Men\xFCs ab."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100671
    m_Localized: "\xC4NDERUNGEN ZUR SERIE"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100672
    m_Localized: "Nur Optik \xB7 Upgrades und Setup bleiben erhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100673
    m_Localized: "W\xE4hle eine gekaufte Stufe. Der Wechsel ist kostenlos."
