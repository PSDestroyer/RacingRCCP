  - m_Id: 8555323401
    m_Localized: "\uBBF8\uC644\uB8CC \uC8FC\uD589\uC5D0\uC11C\uB294 \uD06C\uB808\uB527\uC774\uB098
      XP\uB97C \uBC1B\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uC800\uC7A5\uB41C \uC9C4\uD589
      \uC0C1\uD669\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8555323402
    m_Localized: "\uC800\uC7A5\uD558\uC9C0 \uC54A\uACE0 \uB098\uAC08\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 8555323403
    m_Localized: "\uACB0\uACFC\uAC00 \uC800\uC7A5\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.
      \uD68D\uB4DD\uD55C \uD06C\uB808\uB527\uACFC XP\uB97C \uC783\uAC8C \uB429\uB2C8\uB2E4."
