  - m_Id: 8572100661
    m_Localized: "\uC774 \uC7A5\uCE58\uC758 \uBC84\uD2BC \uC124\uC815 \uCD08\uAE30\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 8572100663
    m_Localized: "\uC804\uCCB4 \uD654\uBA74\uACFC \uCC3D \uBAA8\uB4DC\uB97C \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100664
    m_Localized: "\uC870\uC791 UI\uB97C \uD654\uBA74 \uAC00\uC7A5\uC790\uB9AC\uC5D0\uC11C
      \uC548\uCABD\uC73C\uB85C \uC62E\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100665
    m_Localized: "\uCD5C\uB300 \uD504\uB808\uC784 \uC218\uB97C \uC124\uC815\uD569\uB2C8\uB2E4.
      \uC218\uC9C1 \uB3D9\uAE30\uD654\uAC00 \uC6B0\uC120 \uC801\uC6A9\uB420 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100666
    m_Localized: "\uC774 \uBE4C\uB4DC\uC5D0 \uC124\uC815\uB41C \uADF8\uB798\uD53D
      \uD504\uB9AC\uC14B\uC744 \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100667
    m_Localized: "\uD504\uB808\uC784 \uD45C\uC2DC\uB97C \uB514\uC2A4\uD50C\uB808\uC774\uC5D0
      \uB3D9\uAE30\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100668
    m_Localized: "\uBCF8\uBB38 \uAE00\uC790 \uD06C\uAE30\uB97C \uCD5C\uB300 115%\uB85C
      \uC870\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100669
    m_Localized: "\uD654\uBA74\uACFC \uC120\uD0DD \uD56D\uBAA9\uC744 \uC560\uB2C8\uBA54\uC774\uC158
      \uC5C6\uC774 \uC804\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8572100670
    m_Localized: "\uBA54\uB274 \uB4A4 \uCC28\uACE0\uB97C \uC5B4\uB461\uAC8C \uD558\uC5EC
      \uAE00\uC790 \uB300\uBE44\uB97C \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
