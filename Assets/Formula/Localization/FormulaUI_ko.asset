  - m_Id: 8551129089
    m_Localized: "\uCEE4\uB9AC\uC5B4 \uD06C\uB808\uB527\uC774\uB098 XP\uB97C \uBC1B\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uCEE4\uB9AC\uC5B4 \uC9C4\uD589 \uC0C1\uD669\uC740
      \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8551129090
    m_Localized: "\uBCF4\uC0C1\uC5D0\uB294 \uC644\uC8FC \uBCF4\uC0C1\uACFC \uC544\uC9C1
      \uBC1B\uC9C0 \uC54A\uC740 \uBA54\uB2EC \uBCF4\uB108\uC2A4\uAC00 \uD3EC\uD568\uB429\uB2C8\uB2E4.\n\uC720\uD6A8\uD55C
      \uB7A9\uC740 \uD2B8\uB799 \uD55C\uACC4 \uC548\uC5D0\uC11C \uBAA8\uB4E0 \uCCB4\uD06C\uD3EC\uC778\uD2B8\uB97C
      \uD1B5\uACFC\uD574\uC57C \uD569\uB2C8\uB2E4."
