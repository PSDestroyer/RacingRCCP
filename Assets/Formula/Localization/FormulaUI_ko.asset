  - m_Id: 8534351874
    m_Localized: "\uCD94\uAC00 \uB2E8\uC810 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351875
    m_Localized: "\uC811\uC9C0\uB825\uC774 \uCDA9\uBD84\uD558\uBA74 \uD1A0\uD06C\uAC00
      \uB192\uC744\uC218\uB85D \uAC00\uC18D\uB825\uC774 \uD5A5\uC0C1\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351876
    m_Localized: "\uC81C\uB3D9 \uD1A0\uD06C +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351877
    m_Localized: "\uC55E\uB4A4 \uC81C\uB3D9 \uADE0\uD615\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351878
    m_Localized: "\uC81C\uB3D9 \uD1A0\uD06C\uAC00 \uB192\uC744\uC218\uB85D \uC81C\uB3D9\uB825\uC774
      \uCEE4\uC9D1\uB2C8\uB2E4. \uC811\uC9C0\uB825\uACFC ABS\uC5D0 \uB530\uB77C \uC81C\uB3D9
      \uAC70\uB9AC\uAC00 \uC81C\uD55C\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351879
    m_Localized: "\uC2A4\uD504\uB9C1 +{0:0.#}% \u2192 +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351880
    m_Localized: "\uB310\uD551 +{0:0.#}% \xB7 \uC548\uD2F0\uB864 +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351881
    m_Localized: "\uCC28\uCCB4 \uBC18\uC751\uC774 \uB2E8\uB2E8\uD574\uC9C0\uC9C0\uB9CC
      \uC694\uCCA0 \uD761\uC218\uB825\uC740 \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351882
    m_Localized: "\uB2E4\uC6B4\uD3EC\uC2A4 +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351883
    m_Localized: "\uACF5\uAE30 \uC800\uD56D +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351884
    m_Localized: "\uACE0\uC18D \uCF54\uB108 \uC811\uC9C0\uB825\uC774 \uC99D\uAC00\uD558\uC9C0\uB9CC
      \uACF5\uAE30 \uC800\uD56D\uB3C4 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351885
    m_Localized: "\uC794\uC561: "
    m_Metadata:
      m_Items: []
