  - m_Id: 8534351872
    m_Localized: "\u0413\u041B\u0410\u0412\u041D\u041E\u0415 \u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351873
    m_Localized: "\u041A\u0440\u0443\u0442\u044F\u0449\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351874
    m_Localized: "\u0411\u0435\u0437 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351875
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0438\u0439 \u043A\u0440\u0443\u0442\u044F\u0449\u0438\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442
      \u0440\u0430\u0437\u0433\u043E\u043D \u043F\u0440\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u043C
      \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351876
    m_Localized: "\u0422\u043E\u0440\u043C\u043E\u0437\u043D\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351877
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0431\u0430\u043B\u0430\u043D\u0441 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0445
      \u0438 \u0437\u0430\u0434\u043D\u0438\u0445 \u0442\u043E\u0440\u043C\u043E\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351878
    m_Localized: "\u0422\u043E\u0440\u043C\u043E\u0437\u043D\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0442\u043E\u0440\u043C\u043E\u0436\u0435\u043D\u0438\u044F.
      \u0421\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0438 ABS \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u044E\u0442
      \u0442\u043E\u0440\u043C\u043E\u0437\u043D\u043E\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351879
    m_Localized: "\u041F\u0440\u0443\u0436\u0438\u043D\u044B +{0:0.#}% \u2192 +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351880
    m_Localized: "\u0410\u043C\u043E\u0440\u0442\u0438\u0437\u0430\u0446\u0438\u044F
      +{0:0.#}% \xB7 \u0421\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0442\u043E\u0440
      +{1:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351881
    m_Localized: "\u0411\u043E\u043B\u0435\u0435 \u043E\u0442\u0437\u044B\u0432\u0447\u0438\u0432\u043E\u0435
      \u0448\u0430\u0441\u0441\u0438, \u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435
      \u043F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u0438 \u043D\u0430 \u043D\u0435\u0440\u043E\u0432\u043D\u043E\u0441\u0442\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351882
    m_Localized: "\u041F\u0420\u0418\u0416\u0418\u041C\u041D\u0410\u042F \u0421\u0418\u041B\u0410
      +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351883
    m_Localized: "\u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      +{0}% \u2192 +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8534351884
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0432 \u0431\u044B\u0441\u0442\u0440\u044B\u0445 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430\u0445,
      \u043D\u043E \u0432\u044B\u0448\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 8534351885
    m_Localized: "\u0411\u0430\u043B\u0430\u043D\u0441: "
    m_Metadata:
      m_Items: []
  - m_Id: 8534351886
    m_Localized: " CR \xB7 \u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
